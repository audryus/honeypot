[default]
region = us-east-1
output = json
cli_pager =

[profile production]
region = us-east-1
output = json
role_arn = arn:aws:iam::@@DIGITS:12:awsacct@@:role/ProductionDeployRole
source_profile = default
mfa_serial = arn:aws:iam::@@DIGITS:12:awsacct@@:mfa/deploy-bot

[profile staging]
region = us-west-2
output = json
role_arn = arn:aws:iam::@@DIGITS:12:awsacct@@:role/StagingDeployRole
source_profile = default

[profile dev]
region = us-east-1
output = yaml
s3 =
    max_concurrent_requests = 20
    multipart_threshold = 64MB
    multipart_chunksize = 16MB

[profile backup]
region = eu-west-1
output = json
role_arn = arn:aws:iam::@@DIGITS:12:awsacct@@:role/BackupOperator
source_profile = default

[profile terraform]
region = us-east-1
output = json
role_arn = arn:aws:iam::@@DIGITS:12:awsacct@@:role/TerraformExecution
source_profile = default