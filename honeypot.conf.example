# =============================================================================
#  Bait-file tripwire configuration
# =============================================================================
#
#  HOW TO USE THIS FILE
#    1. Copy it next to install.sh as "honeypot.conf" (that name is git-ignored,
#       so your tokens and chosen names never end up in the repository):
#           cp honeypot.conf.example honeypot.conf
#    2. Edit it: at least pick your own STEALTH names and one notification channel.
#    3. Run:  sudo ./install.sh   (better: from a root shell with history off,
#       see "Quick start" in README.md, so neither your shell history nor the
#       sudo log shows the repo or which decoys you picked)
#       install.sh copies this file to CONF_PATH (see below), root-only (mode 600).
#
#  FORMAT
#    KEY=value, one per line. No spaces around "=". Quotes are optional
#    (KEY="a b" and KEY=a b are the same). Lines starting with # are ignored.
#
#  WHEN CHANGES TAKE EFFECT
#    - STEALTH section: only when install.sh runs (see "renaming" below).
#    - Everything else: edit the INSTALLED copy at CONF_PATH. It is re-read on
#      every event, so there is nothing to restart.
#
# =============================================================================


# -----------------------------------------------------------------------------
#  STEALTH: names on disk
# -----------------------------------------------------------------------------
#  An intruder who spots a trap-looking service, process or file simply avoids
#  the bait, so nothing installed should give it away. These defaults are PUBLIC (they
#  are in this repository), so anyone who knows the project could look for them.
#  Change them to something of your own that fits your system.
#
#  Who can see each name:
#    [everyone]  any logged-in user (systemctl, ps, ls)   -> change these first
#    [root]      only root (they're already game over, but why help them)
#
#  Tips for a convincing name:
#    - Mimic something already on the box (polkit, udisks, fwupd, colord,
#      packagekit, NetworkManager-dispatcher, a cloud/vendor agent...).
#    - Keep names consistent with each other (same "vendor" everywhere).
#    - Never reuse a name that already exists; install.sh refuses to overwrite
#      a real unit or file.
#
#  RENAMING AN EXISTING INSTALL
#    install.sh / uninstall.sh only know the names written here. To switch names:
#      sudo ./uninstall.sh      # while this file still has the OLD names
#      (edit the names)
#      sudo ./install.sh        # installs under the NEW names
#    (Old installs using the original "honeypot" names are migrated automatically.)

# [everyone] systemd unit name, without ".service". Shown by
#   `systemctl list-units`, `systemctl status`, and in the journal.
#   Letters, digits, . _ - only.
#   Examples: polkit-agent-helper, udisks2-monitor, fwupd-refresh-agent
SERVICE_NAME=polkit-agent-helper

# [everyone] Description line of that unit (`systemctl status`, boot messages).
#   Letters, digits, spaces and . _ ( ) / - only.
#   Examples: Authorization Agent Helper, Disk Manager Monitor
SERVICE_DESCRIPTION=Authorization Agent Helper

# [everyone] Where the handler program is installed. This full path is what
#   `ps aux` / `top` show (as "python3 <path>"). Installed root-only (mode 700),
#   so others can see it exists but cannot read it.
#   Examples: /usr/lib/polkit-1/polkit-agent-helper
#             /usr/libexec/udisks2/udisks-monitor
#             /usr/local/lib/fwupd/fwupd-agent
#   NixOS: keeps nothing real under /usr, pick a folder under /var/lib
#             (e.g. /var/lib/polkit-1/agent-helper)
HANDLER_PATH=/usr/lib/polkit-1/polkit-agent-helper

# [everyone*] Where this config is installed (mode 600, root only).
#   *Others can see the file exists if its folder is listable.
#   It is baked into the installed handler, so no flag shows up in `ps`.
#   Examples: /etc/polkit-1/agent-helper.conf, /etc/udisks2/monitor.conf
CONF_PATH=/etc/polkit-1/agent-helper.conf

# [everyone*] Folder for the detailed incident reports (one .log per event,
#   root only). The journal only gets a bland one-liner pointing here.
#   Examples: /var/lib/polkit-1/agent-cache, /var/cache/udisks2/monitor
REPORT_DIR=/var/lib/polkit-1/agent-cache

# [root] Audit rules file name inside /etc/audit/rules.d/ (".rules" is added).
#   The number sets load order; any 10-90 is fine. (NixOS: the handler loads
#   this file itself at every start.)
#   Examples: 50-polkit, 40-udisks, 60-local
RULES_NAME=50-polkit

# [root] Audit key that tags bait events (`auditctl -l`, `ausearch -k`).
#   Max 31 chars: letters, digits, . _ -
#   Examples: pk-auth, udisks-mon, perm_mod
AUDIT_KEY=pk-auth

# [root] nftables table holding the ban sets (`nft list ruleset`).
#   Letters, digits and _ only, starting with a letter.
#   Examples: raw_filter, filter_early, netguard
NFT_TABLE=raw_filter


# -----------------------------------------------------------------------------
#  BAIT
# -----------------------------------------------------------------------------
# Absolute paths of the watched bait files, space separated. Written by
# install.sh from its -e / -f options, so leave it alone here. Pick decoys at
# install time instead (see examples/README.md), e.g.:
#     sudo ./install.sh -e .aws -e projects
BAIT_FILE=
# The subset of BAIT_FILE that install.sh created (decoys, missing -f files).
# Only these are deleted by `uninstall.sh --purge`; an existing file you chose
# to watch with -f is never deleted. Also written by install.sh: leave it alone.
BAIT_CREATED=


# -----------------------------------------------------------------------------
#  NOTIFICATION LOOK
# -----------------------------------------------------------------------------
# Machine name shown in alerts ("... triggered on <HOST_LABEL>").
# Empty = the machine's hostname.   Example: HOST_LABEL=homelab-nas
HOST_LABEL=


# -----------------------------------------------------------------------------
#  CONTAINMENT (what happens to the intruder)
# -----------------------------------------------------------------------------
# yes = end the intruder's login session (loginctl terminate-session).
#   If there is no login session (web shell, cron, container), only the process
#   that touched the bait and its parent shell are killed, never anything higher
#   up (that could be a real service).
#   no  = don't kill anything. NOT monitor-only by itself: with BAN_IP=yes the
#         source IP is still banned and its connections cut (which drops an
#         SSH session anyway). For a pure monitor-only test set both to no.
KILL_SESSION=yes

# yes = drop ALL traffic from the source IP (SSH, web UIs, databases...) and cut
#   its open connections. Only works when the intruder came over the network
#   (SSH); local or container access has no source IP.
BAN_IP=yes

# How long a ban lasts. nft time units: s, m, h, d (they can be combined).
#   Examples: 30m, 1h, 12h, 1d, 7d, 1d12h
#   Bans are kept in memory: a reboot or `nft flush ruleset` clears them.
#   An invalid value falls back to 1h.
#   List bans:  sudo <HANDLER_PATH> --bans
#   Unban:      sudo <HANDLER_PATH> --unban 203.0.113.7
BAN_TIMEOUT=1h

# IPs that are NEVER banned (their session is still killed). Space separated,
#   single addresses only (no ranges). Loopback is never banned anyway.
#   The ban uses the source IP seen by the kernel (sshd's connection) or by
#   logind, never SSH_CONNECTION from the environment: the intruder can set
#   that to anything, e.g. one of these addresses, to dodge the ban.
#   Put at least one machine here that you can always recover from, otherwise
#   opening the bait by mistake from your own laptop locks it out.
#   Example: BAN_SAFE_IPS=192.168.1.10 192.168.1.11 fd00::10
BAN_SAFE_IPS=


# -----------------------------------------------------------------------------
#  NOISE CONTROL (avoiding false alarms)
# -----------------------------------------------------------------------------
# Backup or indexing tools that read your whole home folder will set off the
#   alarm. Exclude the bait paths in THAT tool's own configuration (restic
#   --exclude, borg --exclude, baloo/tracker excluded folders...). There is
#   deliberately no "allowed programs" list: an intruder could simply use the
#   allowed program (rsync, tar, python...) to read the bait silently.

# Login uids (auid) to ignore completely, space separated. auid is the user who
#   originally logged in, even after sudo/su. Normally leave EMPTY: ignoring
#   your own uid also ignores anyone who steals your account. Never list
#   4294967295 ("unset"): that ignores every daemon, cron job and web shell.
#   Example: IGNORE_AUIDS=1001
IGNORE_AUIDS=

# One alert per session (or per process, when there's no session) within this
#   many seconds. `cat`, an editor, a grep... can open the file several times.
#   A plain number of seconds; an invalid value falls back to 30.
DEBOUNCE_SECONDS=30


# -----------------------------------------------------------------------------
#  ENRICHMENT (extra details in the report)
# -----------------------------------------------------------------------------
# yes = look up city / country / ISP of PUBLIC source IPs via ipinfo.io
#   (LAN addresses are never sent). no = never contact ipinfo.io.
IP_LOOKUP=yes


# -----------------------------------------------------------------------------
#  LIVENESS (you'll install this and forget it: it has to speak up by itself)
# -----------------------------------------------------------------------------
# Every 15 minutes the handler checks the trap can still fire: bait files
#   exist, their audit rules are loaded, auditd runs, kernel auditing is on.
#   If not, you get a "PROBLEM" alert right away (and "recovered" when fixed).
#   Check by hand any time:  sudo <HANDLER_PATH> --health

# Send a low-priority "still watching" message every N days, with the check
#   results and the number of alerts since the last one. If it stops coming,
#   the box, the service or your notification channel is broken.
#   0 = off. Fractions work (0.5 = every 12h). An invalid value falls back to 7.
HEARTBEAT_DAYS=7

# Optional dead-man's switch: a URL fetched every 15 minutes while all checks
#   pass. A monitoring service alerts YOU when the pings stop, which also
#   covers the cases where this machine can't tell you anything (powered off,
#   network down, notification token revoked). Free options: healthchecks.io
#   (set period 15 min, grace 30 min), a self-hosted Uptime Kuma "Push" monitor.
#   Example: HEARTBEAT_URL=https://hc-ping.com/3f9c1a7e-5b2d-48c0-a6e1-f4b9d7c2e8a1
HEARTBEAT_URL=


# -----------------------------------------------------------------------------
#  AUDIT LOG
# -----------------------------------------------------------------------------
# The auditd log the handler follows. Only change it if auditd.conf's log_file
#   points elsewhere. Unlike the other settings it is read once at start:
#   restart the service after changing it (systemctl restart <SERVICE_NAME>).
AUDIT_LOG=/var/log/audit/audit.log


# -----------------------------------------------------------------------------
#  NOTIFICATIONS (configure one or more; all configured ones are used)
# -----------------------------------------------------------------------------
# Check them after editing:  sudo <HANDLER_PATH> --test

# ntfy (simplest, free): install the ntfy app on your phone and subscribe to a
#   topic. Anyone who knows the topic name can read AND send to it, so make it
#   long and random, e.g. the output of:  openssl rand -hex 16
#   Example: NTFY_URL=https://ntfy.sh/3f9c1a7e5b2d48c0a6e1f4b9d7c2e8a1
#   Self-hosted: NTFY_URL=https://ntfy.example.com/alerts  plus NTFY_TOKEN
NTFY_URL=
# Access token, only for protected topics / self-hosted servers.
#   Example: NTFY_TOKEN=tk_abc123...
NTFY_TOKEN=

# Telegram: talk to @BotFather -> /newbot -> copy the token. Send any message to
#   your new bot, then get your chat id from @userinfobot.
#   Example: TELEGRAM_BOT_TOKEN=123456789:AAH-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#            TELEGRAM_CHAT_ID=987654321
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord: Channel settings -> Integrations -> Webhooks -> New -> Copy URL.
#   Example: DISCORD_WEBHOOK=https://discord.com/api/webhooks/123/abcDEF...
DISCORD_WEBHOOK=

# Any endpoint (Home Assistant, n8n, Gotify proxy, your own script) that accepts
#   a JSON POST:  {"title": "...", "message": "...", "event": {full details}}
#   Example: WEBHOOK_URL=http://homeassistant.lan:8123/api/webhook/tripwire-x7k2
WEBHOOK_URL=
